# Set Piece static SPA for Apache (Namecheap / cPanel).
# Vite copies this file into dist/ with the rest of public/.

DirectoryIndex index.html
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS. The forwarded-proto check avoids a loop when TLS is terminated upstream.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Maintenance mode. Uncomment the six lines below to show maintenance.html
  # for every visit (HTTP 503) while still serving the logo and favicon.
  # RewriteCond %{ENV:REDIRECT_STATUS} !=503
  # RewriteCond %{REQUEST_URI} !^/maintenance\.html$ [NC]
  # RewriteCond %{REQUEST_URI} !^/images/setpiece-logo\.png$ [NC]
  # RewriteCond %{REQUEST_URI} !^/favicon\.svg$ [NC]
  # RewriteRule ^ - [R=503,L]
  # ErrorDocument 503 /maintenance.html

  # Serve real files and folders, including /api/contact.php.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Direct visits and refreshes on client routes load the SPA shell.
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|mjs|woff2|svg|png|jpe?g|webp|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
